# Port the website listens on.
PORT=3000
# Long random secret for the /admin dashboard. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# Folder where orders, bookings, reviews and menu edits are saved.
DATA_DIR=./storage
# Set to 1 when running behind a proxy/load balancer (Render, Nginx, Cloudflare).
TRUST_PROXY=0
