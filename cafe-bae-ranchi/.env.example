# Port the website listens on.
PORT=3000

# Master key: used once to create the owner's account at /admin, and as an
# emergency master login. Keep it secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Folder where orders, bookings, staff accounts and settings are saved.
DATA_DIR=./storage

# Set to 1 when running behind a proxy/load balancer (Render, Nginx, Cloudflare).
TRUST_PROXY=0

# WhatsApp Business Cloud API (optional). Without these, staff still get
# one-tap WhatsApp buttons. See README "WhatsApp setup".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v23.0
