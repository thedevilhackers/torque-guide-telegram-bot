# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional but recommended: OpenAI Platform API key for AI vehicle search, AI Stage 1 reports and Ask AI.
# Without it the bot still works using the built-in vehicle list and reports.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Your business
BUSINESS_NAME=Unity Performance
# WhatsApp number that receives customer enquiries: international format, e.g. 94771234567
WHATSAPP_NUMBER=

# Optional: workshop location for the "Our workshop" button (address, coordinates, or both)
WORKSHOP_ADDRESS=
WORKSHOP_LATITUDE=
WORKSHOP_LONGITUDE=
