# Admin panel (/admin). The panel stays locked until ADMIN_PASSWORD has at least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Telegram bot token from @BotFather. Optional: without it the website runs and the bot is off.
TELEGRAM_BOT_TOKEN=

# Optional but recommended: OpenAI Platform API key for AI vehicle search, AI Stage 1 reports and Ask AI.
# Without it everything still works using the built-in vehicle list and reports.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Most AI requests a day across all customers (default 400). Each customer also gets 20 an hour.
AI_DAILY_LIMIT=

# Starting values for your business details. After the first run, edit them in Admin → Settings;
# any setting left empty there falls back to these.
BUSINESS_NAME=Unity Performance
# WhatsApp number that receives orders and enquiries: international format, e.g. 94771234567
WHATSAPP_NUMBER=
WORKSHOP_ADDRESS=
WORKSHOP_LATITUDE=
WORKSHOP_LONGITUDE=

# Optional: web port (default 3000) and where the database and uploads are stored (default ./data)
PORT=
DATA_DIR=
# Optional: the address to listen on. On a VPS behind Caddy use 127.0.0.1 (the VPS installer does this).
HOST=
